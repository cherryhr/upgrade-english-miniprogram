/* pages/songs/index.wxss */
page {
  background: #0a1628;
  min-height: 100vh;
}

.page {
  padding: 0 24rpx;
}

/* 顶部标题 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
  background: linear-gradient(135deg, rgba(255,154,60,0.15), rgba(255,107,53,0.1));
  border-radius: 0 0 40rpx 40rpx;
  margin: 0 -24rpx 30rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 10rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #F5C518;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}

.header-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 12rpx;
}

/* 歌曲列表 */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 单元标题 */
.unit-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
}

.unit-emoji {
  font-size: 48rpx;
}

.unit-text {
  font-size: 28rpx;
  font-weight: 800;
  color: white;
}

.unit-zh {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-left: auto;
}

/* 视频网格 */
.video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.video-card {
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: transform 0.2s;
  border: 2rpx solid rgba(255,255,255,0.08);
}

.video-card:active {
  transform: scale(0.96);
  background: rgba(255,255,255,0.1);
}

.video-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.video-title {
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 6rpx;
}

.video-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 视频播放器 */
.player-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.player-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.player-back {
  color: #F5C518;
  font-size: 32rpx;
  font-weight: 700;
  padding: 30rpx;
  text-align: center;
}

.video-player {
  flex: 1;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-info {
  padding: 30rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.info-title {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 8rpx;
}

.info-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 6rpx;
}

.info-unit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
