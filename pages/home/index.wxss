/* pages/home/index.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1628 0%, #0d1f3c 100%);
  padding: 0 24rpx;
}

/* 顶部欢迎区 */
.hero {
  text-align: center;
  padding: 50rpx 0 30rpx;
}

.hero-emoji {
  font-size: 100rpx;
  margin-bottom: 12rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.hero-title {
  font-size: 52rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #F5C518, #FF8C42);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 20rpx;
}

.hero-stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.star-icon { font-size: 36rpx; }

.star-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #F5C518;
}

.streak-badge {
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* 字母学习模块 */
.module-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: transform 0.2s;
}

.module-card:active {
  transform: scale(0.97);
}

.module-emoji {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.module-info {
  flex: 1;
}

.module-name {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
}

.module-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.module-arrow {
  font-size: 48rpx;
  color: rgba(255,255,255,0.5);
}

/* 章节标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-text {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  white-space: nowrap;
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255,255,255,0.1);
}

/* 单元网格 */
.unit-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.unit-card {
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.unit-card:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}

.unit-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.unit-emoji {
  font-size: 60rpx;
}

.unit-id {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.1);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.unit-name {
  font-size: 26rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
  line-height: 1.3;
}

.unit-zh {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 12rpx;
}

.unit-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.progress-bar {
  flex: 1;
  height: 6rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 18rpx;
  color: rgba(255,255,255,0.5);
  min-width: 60rpx;
  text-align: right;
}
