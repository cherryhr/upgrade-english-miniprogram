/* pages/home/index.wxss */
page {
  background: #0a1628;
  min-height: 100vh;
}

.page {
  padding: 0 30rpx;
}

/* 顶部欢迎区 */
.hero {
  text-align: center;
  padding: 40rpx 0 30rpx;
  background: linear-gradient(135deg, rgba(245,197,24,0.1), rgba(255,140,66,0.1));
  border-radius: 0 0 40rpx 40rpx;
  margin: 0 -30rpx 30rpx;
}

.hero-emoji {
  font-size: 80rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #F5C518;
  text-shadow: 0 4rpx 20rpx rgba(245,197,24,0.3);
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}

.hero-stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.star-icon {
  font-size: 32rpx;
}

.star-count {
  font-size: 26rpx;
  color: #F5C518;
  font-weight: 700;
}

.streak-badge {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: white;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 700;
}

/* 快捷入口网格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.quick-card {
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  text-align: center;
  transition: transform 0.2s;
  position: relative;
  overflow: hidden;
}

.quick-card:active {
  transform: scale(0.96);
}

.quick-songs {
  background: linear-gradient(135deg, #ff9a3c, #ff6b35);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.quick-abc {
  background: linear-gradient(135deg, #667eea, #764ba2);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.quick-review {
  background: linear-gradient(135deg, #11998e, #38ef7d);
  box-shadow: 0 8rpx 24rpx rgba(56, 239, 125, 0.3);
}

.quick-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.quick-name {
  font-size: 32rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 4rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 10rpx;
}

.quick-tag {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

/* 章节标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-text {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.8);
}

/* 单元列表 */
.unit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.unit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
}

.unit-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.unit-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.unit-emoji {
  font-size: 56rpx;
}

.unit-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.unit-name {
  font-size: 28rpx;
  font-weight: 800;
  color: white;
}

.unit-zh {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.unit-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.unit-progress {
  background: rgba(0,0,0,0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.progress-text {
  font-size: 22rpx;
  color: white;
  font-weight: 700;
}

.unit-arrow {
  font-size: 40rpx;
  color: white;
  opacity: 0.7;
}
