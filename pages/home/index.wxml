<!-- pages/home/index.wxml -->
<view class="page">
  <!-- 顶部欢迎区 -->
  <view class="hero">
    <view class="hero-emoji">🚀</view>
    <view class="hero-title">UpGrade English</view>
    <view class="hero-sub">Oxford Phonics World · 儿童英语学习</view>
    <view class="hero-stars">
      <text class="star-icon">⭐</text>
      <text class="star-count">{{stars}} 颗星星</text>
      <text class="streak-badge" wx:if="{{streak > 0}}">🔥 {{streak}}天连续</text>
    </view>
  </view>

  <!-- 快捷入口网格 -->
  <view class="quick-grid">
    <!-- 综合复习 -->
    <view class="quick-card quick-review" bindtap="goReview">
      <view class="quick-icon">🎯</view>
      <view class="quick-name">Review</view>
      <view class="quick-desc">综合复习</view>
      <view class="quick-tag">20 Questions</view>
    </view>

    <!-- Songs 歌曲 -->
    <view class="quick-card quick-songs" bindtap="goSongs">
      <view class="quick-icon">🎵</view>
      <view class="quick-name">Songs</view>
      <view class="quick-desc">歌曲视频</view>
      <view class="quick-tag">21 Videos</view>
    </view>

    <!-- ABC 字母 -->
    <view class="quick-card quick-abc" bindtap="goModule" data-id="abc">
      <view class="quick-icon">🔤</view>
      <view class="quick-name">ABC</view>
      <view class="quick-desc">字母学习</view>
      <view class="quick-tag">26 Letters</view>
    </view>
  </view>

  <!-- 单元学习列表 -->
  <view class="section-title">
    <text class="section-icon">📚</text>
    <text class="section-text">12个单元 · Units 1-12</text>
  </view>

  <view class="unit-list">
    <block wx:for="{{units}}" wx:key="id">
      <view class="unit-card" style="background: {{item.color}}" bindtap="goUnit" data-id="{{item.id}}">
        <view class="unit-left">
          <text class="unit-emoji">{{item.emoji}}</text>
          <view class="unit-info">
            <text class="unit-name">{{item.name}}</text>
            <text class="unit-zh">{{item.zh}}</text>
          </view>
        </view>
        <view class="unit-right">
          <view class="unit-progress">
            <text class="progress-text">{{item.progress || 0}}%</text>
          </view>
          <text class="unit-arrow">›</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部间距 -->
  <view style="height: 200rpx"></view>
</view>
