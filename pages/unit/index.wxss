/* pages/unit/index.wxss */

/* ============================================
   全局动画配置
   ============================================ */

/* 入场动画 - 渐入上移 */
@keyframes fadeInUp {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* 缩放弹跳 */
@keyframes scaleBounce {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

/* 闪烁星星 */
@keyframes twinkle {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.9); }
}

/* 呼吸灯效果 */
@keyframes breathe {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* 波浪动画 */
@keyframes wave {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* 旋转加载 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 弹跳成功 */
@keyframes successBounce {
  0% { transform: scale(1); }
  25% { transform: scale(1.2); }
  50% { transform: scale(0.9); }
  75% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 抖动错误 */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}

/* 涟漪扩散 */
@keyframes ripple {
  0% { transform: scale(0); opacity: 1; }
  100% { transform: scale(2.5); opacity: 0; }
}

/* ============================================
   增强的标签栏动画
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1628 0%, #0d1f3c 100%);
  padding: 0 24rpx;
}

/* 入场延迟动画类 */
.anim-fade-in {
  animation: fadeInUp 0.4s ease-out backwards;
}
.anim-delay-1 { animation-delay: 0.05s; }
.anim-delay-2 { animation-delay: 0.1s; }
.anim-delay-3 { animation-delay: 0.15s; }
.anim-delay-4 { animation-delay: 0.2s; }
.anim-delay-5 { animation-delay: 0.25s; }

/* 标签栏 */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.tab-item {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

/* 标签点击涟漪效果 */
.tab-item::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
  transform: translate(-50%, -50%) scale(0);
  opacity: 0;
  transition: transform 0.5s, opacity 0.5s;
}

.tab-item:active::after {
  transform: translate(-50%, -50%) scale(0);
  animation: ripple 0.6s ease-out;
  opacity: 1;
}

.tab-item.active {
  background: #F5C518;
  color: #1B4FD8;
  border-color: #F5C518;
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(245, 197, 24, 0.4);
}

.tab-item:not(.active):hover {
  background: rgba(255,255,255,0.15);
  color: white;
}

/* 内容区 */
.content {
  padding-bottom: 40rpx;
}

/* 词汇网格 */
.vocab-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

/* 词汇卡片入场动画 */
.vocab-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx 10rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), 
              box-shadow 0.2s ease;
  animation: scaleBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  position: relative;
  overflow: hidden;
}

/* 卡片间隔延迟 */
.vocab-grid .vocab-card:nth-child(1) { animation-delay: 0.02s; }
.vocab-grid .vocab-card:nth-child(2) { animation-delay: 0.04s; }
.vocab-grid .vocab-card:nth-child(3) { animation-delay: 0.06s; }
.vocab-grid .vocab-card:nth-child(4) { animation-delay: 0.08s; }
.vocab-grid .vocab-card:nth-child(5) { animation-delay: 0.10s; }
.vocab-grid .vocab-card:nth-child(6) { animation-delay: 0.12s; }
.vocab-grid .vocab-card:nth-child(7) { animation-delay: 0.14s; }
.vocab-grid .vocab-card:nth-child(8) { animation-delay: 0.16s; }
.vocab-grid .vocab-card:nth-child(9) { animation-delay: 0.18s; }
.vocab-grid .vocab-card:nth-child(n+10) { animation-delay: 0.2s; }

/* 点击涟漪效果 */
.vocab-card::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(27, 79, 216, 0.15) 0%, transparent 60%);
  transform: translate(-50%, -50%) scale(0);
  opacity: 0;
  pointer-events: none;
}

.vocab-card:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.vocab-card:active::after {
  animation: ripple 0.5s ease-out;
  opacity: 1;
}

/* 播放状态高亮 */
.vocab-card.playing {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border: 2rpx solid #64B5F6;
  animation: successBounce 0.3s ease;
}

.vocab-emoji {
  display: block;
  font-size: 60rpx;
  margin-bottom: 8rpx;
  transition: transform 0.3s ease;
}

.vocab-card:active .vocab-emoji {
  transform: scale(1.15);
}

.vocab-en {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #1B4FD8;
}

.vocab-zh {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-top: 2rpx;
}

/* ABC 字母卡片特殊样式 */
.abc-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.abc-card .vocab-en {
  font-size: 56rpx;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.abc-card .vocab-zh {
  color: rgba(255,255,255,0.8);
  font-size: 18rpx;
}

/* 问答列表 */
.qa-list {}

.qa-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  animation: fadeInUp 0.4s ease-out backwards;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.qa-card:nth-child(1) { animation-delay: 0.05s; }
.qa-card:nth-child(2) { animation-delay: 0.1s; }
.qa-card:nth-child(3) { animation-delay: 0.15s; }
.qa-card:nth-child(4) { animation-delay: 0.2s; }

.qa-card:active {
  transform: scale(0.98);
}

.qa-q, .qa-a {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qa-q {
  background: #E3F2FD;
}

.qa-icon {
  font-size: 48rpx;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.qa-card:active .qa-icon {
  transform: scale(1.2) rotate(5deg);
}

.qa-text-wrap {
  flex: 1;
}

.qa-en {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1565C0;
}

.qa-zh {
  display: block;
  font-size: 22rpx;
  color: #555;
  margin-top: 2rpx;
}

.qa-speak {
  font-size: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
  transition: opacity 0.2s, transform 0.2s;
}

.qa-card:active .qa-speak {
  opacity: 1;
  transform: scale(1.2);
}

/* 歌曲卡片 */
.song-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  animation: fadeInUp 0.5s ease-out backwards;
  position: relative;
  overflow: hidden;
}

/* 卡片光晕效果 */
.song-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: breathe 3s ease-in-out infinite;
}

.song-title {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 16rpx;
}

.song-progress-bar {
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.song-progress-fill {
  height: 100%;
  background: #F5C518;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.song-current {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

.song-lyric {
  font-size: 36rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 24rpx;
}

.song-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.song-btn {
  font-size: 40rpx;
  padding: 10rpx;
}

.song-play-btn {
  background: #F5C518;
  color: #1B4FD8;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 800;
}

/* 歌词列表 */
.lyrics-list {
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  overflow: hidden;
}

/* 歌曲视频区域 */
.song-videos-section {
  margin-bottom: 24rpx;
}

.song-videos-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F5C518;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.song-video-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.song-video-item {
  background: rgba(255,255,255,0.08);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.2s;
  border: 2rpx solid rgba(255,255,255,0.06);
}

.song-video-item:active {
  transform: scale(0.97);
  background: rgba(255,255,255,0.12);
}

.sv-icon {
  font-size: 40rpx;
  color: #F5C518;
  flex-shrink: 0;
}

.sv-info {
  flex: 1;
}

.sv-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 4rpx;
}

.sv-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 视频播放器弹窗 */
.video-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.video-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.video-back {
  color: #F5C518;
  font-size: 32rpx;
  font-weight: 700;
  padding: 30rpx;
  text-align: center;
}

.video-player-wrap {
  flex: 1;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-bottom-info {
  padding: 24rpx 30rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.vi-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 6rpx;
}

.vi-unit {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.lyric-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  transition: background 0.2s;
}

.lyric-item:last-child { border-bottom: none; }

.lyric-item.active {
  background: rgba(245, 197, 24, 0.15);
}

.lyric-num {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  min-width: 40rpx;
  text-align: center;
}

.lyric-texts { flex: 1; }

.lyric-en {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: white;
}

.lyric-zh {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 2rpx;
}

/* 游戏网格 */
.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.game-card {
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.2s ease,
              box-shadow 0.2s ease;
  animation: scaleBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  border: 2rpx solid rgba(255,255,255,0.05);
}

.games-grid .game-card:nth-child(1) { animation-delay: 0.05s; }
.games-grid .game-card:nth-child(2) { animation-delay: 0.1s; }
.games-grid .game-card:nth-child(3) { animation-delay: 0.15s; }
.games-grid .game-card:nth-child(4) { animation-delay: 0.2s; }

.game-card:active {
  transform: scale(0.94);
  background: rgba(255,255,255,0.15);
  box-shadow: 0 4rpx 20rpx rgba(245, 197, 24, 0.2);
}

.game-card:active .game-emoji {
  transform: scale(1.1);
}

.game-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.game-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
}

.game-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 游戏区域 */
.game-area {
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.game-title {
  font-size: 30rpx;
  font-weight: 800;
  color: white;
}

.game-moves, .game-score {
  font-size: 24rpx;
  color: #F5C518;
  font-weight: 700;
}

.game-progress {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 700;
}

/* Memory Match */
.memory-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

/* 匹配提示 */
.memory-hint {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  animation: pulse 0.5s ease;
}

/* 成功提示样式 */
.memory-hint.hint-success {
  background: linear-gradient(135deg, #00cec9, #0984e3);
  box-shadow: 0 4rpx 20rpx rgba(0, 206, 201, 0.4);
}

/* 胜利提示样式 */
.memory-hint.hint-win {
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  box-shadow: 0 4rpx 20rpx rgba(253, 203, 110, 0.5);
  font-size: 36rpx;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

/* 下一题按钮 */
.memory-next-btn {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(39, 174, 96, 0.3);
  animation: pulse 0.5s ease;
}

/* 重新开始按钮 */
.memory-restart-btn {
  background: linear-gradient(135deg, #F5C518, #FF6B6B);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 197, 24, 0.3);
}

/* 调试信息 */
.debug-info {
  background: rgba(255, 200, 0, 0.2);
  border: 2rpx dashed #F5C518;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  color: #F5C518;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.memory-card {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.memory-card.flipped {
  background: white;
}

.memory-card.matched {
  background: #27AE60;
}

.card-front, .card-back {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: opacity 0.3s ease;
}

.card-front {
  color: white;
  font-size: 48rpx;
  font-weight: 900;
}

.card-back {
  opacity: 0;
}

.memory-card.flipped .card-front,
.memory-card.matched .card-front {
  opacity: 0;
}

.memory-card.flipped .card-back,
.memory-card.matched .card-back {
  opacity: 1;
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.card-emoji {
  font-size: 56rpx;
  margin-bottom: 4rpx;
}

.card-en {
  font-size: 32rpx;
  font-weight: 800;
  color: #1B4FD8;
  text-align: center;
  word-break: break-word;
  line-height: 1.2;
  padding: 0 8rpx;
}

.card-emoji {
  display: block;
  font-size: 56rpx;
  margin-bottom: 4rpx;
}

.card-en {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1B4FD8;
  text-align: center;
  word-break: break-word;
  line-height: 1.2;
  padding: 0 8rpx;
}

/* Quiz */
.quiz-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.quiz-q {
  background: #E3F2FD;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quiz-icon { font-size: 56rpx; }

.quiz-en {
  font-size: 30rpx;
  font-weight: 800;
  color: #1565C0;
  text-align: center;
}

.quiz-zh {
  font-size: 24rpx;
  color: #555;
}

.quiz-options {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quiz-option {
  background: #f5f5f5;
  color: #333;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: fadeInUp 0.4s ease-out backwards;
  border: 3rpx solid transparent;
}

.quiz-options .quiz-option:nth-child(1) { animation-delay: 0.05s; }
.quiz-options .quiz-option:nth-child(2) { animation-delay: 0.1s; }
.quiz-options .quiz-option:nth-child(3) { animation-delay: 0.15s; }
.quiz-options .quiz-option:nth-child(4) { animation-delay: 0.2s; }

.quiz-option:active {
  transform: scale(0.96);
}

.quiz-option.correct {
  background: #27AE60;
  color: white;
  border-color: #2ECC71;
  animation: successBounce 0.4s ease;
}

.quiz-option.wrong {
  background: #e74c3c;
  color: white;
  border-color: #E74C3C;
  animation: shake 0.4s ease;
}

.quiz-option.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* Spelling */
.spelling-prompt {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
  animation: scaleBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.3);
}

.spelling-emoji {
  display: block;
  font-size: 80rpx;
  margin-bottom: 12rpx;
  animation: twinkle 2s ease-in-out infinite;
}

.spelling-word {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
  letter-spacing: 4rpx;
}

.spelling-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

.spelling-input-wrap {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.spelling-input {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  border: 3rpx solid transparent;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.spelling-input:focus {
  border-color: #1B4FD8;
  box-shadow: 0 0 0 4rpx rgba(27, 79, 216, 0.2);
}

.spelling-input.error {
  border-color: #e74c3c;
  animation: shake 0.4s ease;
}

.spelling-input.correct {
  border-color: #27AE60;
  animation: successBounce 0.4s ease;
}

.spelling-check-btn {
  background: #1B4FD8;
  color: white;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  transition: transform 0.2s, box-shadow 0.2s;
}

.spelling-check-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(27, 79, 216, 0.3);
}

.spelling-result {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 12rpx;
  animation: fadeInUp 0.3s ease-out;
}

.spelling-result text { color: #27AE60; }

/* Bubble */
.bubble-prompt {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.bubble-task {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.bubble-word {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1B4FD8;
}

.bubble-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.bubble-item {
  background: linear-gradient(135deg, #74b9ff, #0984e3);
  color: white;
  padding: 40rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
              background 0.3s ease,
              box-shadow 0.2s ease;
  animation: scaleBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  border: 3rpx solid rgba(255,255,255,0.2);
}

.bubble-grid .bubble-item:nth-child(1) { animation-delay: 0.05s; }
.bubble-grid .bubble-item:nth-child(2) { animation-delay: 0.1s; }
.bubble-grid .bubble-item:nth-child(3) { animation-delay: 0.15s; }
.bubble-grid .bubble-item:nth-child(4) { animation-delay: 0.2s; }

.bubble-item:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(116, 185, 255, 0.4);
}

.bubble-item.correct {
  background: linear-gradient(135deg, #00b894, #27AE60);
  border-color: #2ECC71;
  animation: successBounce 0.4s ease;
}

.bubble-item.wrong {
  background: linear-gradient(135deg, #d63031, #e74c3c);
  border-color: #E74C3C;
  animation: shake 0.4s ease;
}

/* 下一题按钮 */
.bubble-next-btn {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(39, 174, 96, 0.3);
}

/* 游戏返回按钮 */
.game-back {
  text-align: center;
  color: #F5C518;
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx;
}

/* ============================================
   卡通对话场景 - Cartoon Dialogue Scene
   ============================================ */

/* 场景根容器 */
.dialogue-scene {
  position: relative;
  width: 100%;
  min-height: 800rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0 30rpx 0;
}

/* 场景背景 */
.scene-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 580rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 0 0 60rpx 60rpx;
  overflow: hidden;
  z-index: 0;
}

/* 场景装饰元素 */
.scene-deco {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}
.scene-deco-1 {
  width: 300rpx;
  height: 300rpx;
  background: white;
  top: -100rpx;
  right: -60rpx;
  animation: float1 6s ease-in-out infinite;
}
.scene-deco-2 {
  width: 200rpx;
  height: 200rpx;
  background: #F5C518;
  bottom: 80rpx;
  left: -60rpx;
  animation: float2 8s ease-in-out infinite;
}
.scene-deco-3 {
  width: 120rpx;
  height: 120rpx;
  background: white;
  top: 160rpx;
  left: 80rpx;
  animation: float3 5s ease-in-out infinite;
}

/* 场景头部 */
.scene-header {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 24rpx 0 16rpx;
  width: 100%;
}
.scene-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}
.scene-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

/* 角色区域 */
.characters-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
  padding: 0 10rpx;
  margin-top: 10rpx;
}

/* 单个角色 */
.character {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}
.character.speaking {
  transform: scale(1.1);
  animation: char-bounce 0.4s ease infinite;
}
.character.idle {
  transform: scale(1);
  animation: char-idle 3s ease-in-out infinite;
}

/* ===== Emma 老师角色 ===== */
.emma-avatar {
  width: 120rpx;
  height: 160rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 头发 */
.emma-hair {
  width: 90rpx;
  height: 50rpx;
  background: #5D4037;
  border-radius: 50rpx 50rpx 0 0;
  position: relative;
  z-index: 1;
}
/* 脸部 */
.emma-face {
  width: 80rpx;
  height: 80rpx;
  background: #FFCC80;
  border-radius: 50%;
  position: relative;
  margin-top: -10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFB74D;
}
/* 眼睛 */
.emma-eyes {
  display: flex;
  gap: 20rpx;
  margin-bottom: 4rpx;
}
.eye {
  width: 12rpx;
  height: 12rpx;
  background: #333;
  border-radius: 50%;
}
.eye-happy {
  height: 6rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #333;
  transform: translateY(3rpx);
}
/* 嘴巴 */
.emma-mouth {
  width: 20rpx;
  height: 10rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: #E57373;
}
.mouth-neutral { border-radius: 0; height: 4rpx; }
.mouth-smile { height: 12rpx; border-radius: 0 0 12rpx 12rpx; }
/* 眼镜 */
.emma-glasses {
  position: absolute;
  top: 28rpx;
  width: 70rpx;
  height: 22rpx;
  border: 3rpx solid #333;
  border-radius: 8rpx;
  background: transparent;
}
.emma-glasses::before,
.emma-glasses::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 10rpx;
  height: 3rpx;
  background: #333;
}
.emma-glasses::before { left: -12rpx; }
.emma-glasses::after { right: -12rpx; }
/* 身体 */
.emma-body {
  width: 90rpx;
  height: 60rpx;
  background: #1B4FD8;
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -5rpx;
  position: relative;
}
.emma-body::after {
  content: '📚';
  position: absolute;
  top: 10rpx;
  right: -20rpx;
  font-size: 28rpx;
}

/* ===== Tommy 学生角色 ===== */
.tommy-avatar {
  width: 110rpx;
  height: 150rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tommy-hair {
  width: 80rpx;
  height: 40rpx;
  background: #212121;
  border-radius: 40rpx 40rpx 10rpx 10rpx;
  position: relative;
  z-index: 1;
}
.tommy-hair::before {
  content: '';
  position: absolute;
  top: 5rpx;
  left: 10rpx;
  width: 60rpx;
  height: 20rpx;
  background: #212121;
  border-radius: 30rpx;
}
.tommy-face {
  width: 75rpx;
  height: 75rpx;
  background: #FFCC80;
  border-radius: 50%;
  margin-top: -8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFB74D;
}
.tommy-mouth {
  width: 16rpx;
  height: 8rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #E57373;
}
.mouth-curious {
  width: 20rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid #E57373;
}
.tommy-body {
  width: 80rpx;
  height: 55rpx;
  background: #FF6B6B;
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -3rpx;
  position: relative;
}
.tommy-body::after {
  content: '⭐';
  position: absolute;
  top: 8rpx;
  left: -18rpx;
  font-size: 24rpx;
}

/* 气泡区域 */
.bubble-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  width: 100%;
  padding: 0 8rpx;
  position: relative;
  z-index: 1;
}

/* 气泡基础样式 */
.speech-bubble {
  background: white;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  max-width: 500rpx;
  width: 100%;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  margin: 10rpx 0;
}
.speech-bubble:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.bubble-en {
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.4;
  color: #1a1a2e;
}
.bubble-zh {
  font-size: 24rpx;
  color: #888;
  text-align: center;
}
.bubble-tap-hint {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 4rpx;
}
/* 气泡尾巴 */
.bubble-tail {
  position: absolute;
  top: 30rpx;
  width: 0;
  height: 0;
  border: 14rpx solid transparent;
}
.bubble-tail-left {
  left: -24rpx;
  border-right-color: white;
}
.bubble-tail-right {
  right: -24rpx;
  border-left-color: white;
}

/* 问题气泡 (Emma) - 蓝色系 */
.bubble-q {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border: 3rpx solid #64B5F6;
}
.bubble-q .bubble-tail-left { border-right-color: #BBDEFB; }

/* 回答气泡 (Tommy) - 橙色系 */
.bubble-a {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border: 3rpx solid #FFB74D;
}
.bubble-a .bubble-tail-right { border-left-color: #FFE0B2; }

/* 气泡状态动画 */
.bubble-hidden {
  opacity: 0;
  transform: scale(0.7) translateY(20rpx);
  pointer-events: none;
}
.bubble-in {
  opacity: 1;
  transform: scale(1) translateY(0);
  animation: bubble-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bubble-in.bubble-q {
  animation: bubble-pop-left 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.bubble-in.bubble-a {
  animation: bubble-pop-right 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 等待提示 */
.waiting-hint {
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s;
}
.hint-show {
  opacity: 1;
}
.waiting-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(0,0,0,0.2);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

/* 进度条 - 圆点指示器 */
.dialogue-progress {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 16rpx 20rpx 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.dp-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}
.dp-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  transition: all 0.3s ease;
}
.dp-dot.active {
  width: 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F5C518, #FF6B6B);
  box-shadow: 0 0 12rpx rgba(245,197,24,0.5);
}

/* 句型列表 */
.dialogue-list {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 16rpx 20rpx;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  width: 100%;
  box-sizing: border-box;
}
.dialogue-list::-webkit-scrollbar { display: none; }

.dialogue-item {
  flex-shrink: 0;
  width: 280rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 16rpx;
  padding: 16rpx;
  border: 2rpx solid transparent;
  cursor: pointer;
  transition: all 0.2s;
}
.dialogue-item:active { transform: scale(0.97); }
.dialogue-item.active {
  background: rgba(255,255,255,0.2);
  border-color: #F5C518;
  box-shadow: 0 0 20rpx rgba(245,197,24,0.3);
}
.di-q {
  font-size: 22rpx;
  font-weight: 700;
  color: #BBDEFB;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.di-a {
  font-size: 22rpx;
  color: #FFE0B2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.di-standalone {
  font-size: 24rpx;
  font-weight: 700;
  color: white;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 12rpx 0;
}
.standalone-item {
  background: rgba(245, 197, 24, 0.2);
  border-color: rgba(245, 197, 24, 0.4) !important;
}

/* 播放控制 */
.dialogue-controls {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 12rpx;
  padding: 12rpx 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}
.dc-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 700;
  transition: transform 0.15s;
}
.dc-btn:active { transform: scale(0.95); }
.dc-prev {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.8);
  border: 2rpx solid rgba(255,255,255,0.2);
}
.dc-next {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.8);
  border: 2rpx solid rgba(255,255,255,0.2);
}
.dc-play {
  background: linear-gradient(135deg, #F5C518, #FF9800);
  color: white;
  flex: 1.4;
  box-shadow: 0 4rpx 16rpx rgba(245,197,24,0.4);
  font-size: 28rpx;
}

/* ===== 关键帧动画 ===== */
@keyframes char-bounce {
  0%, 100% { transform: scale(1.1) translateY(0); }
  50% { transform: scale(1.1) translateY(-8rpx); }
}

@keyframes char-idle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes bubble-pop {
  0% { opacity: 0; transform: scale(0.6) translateY(30rpx); }
  70% { transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes bubble-pop-left {
  0% { opacity: 0; transform: scale(0.6) translateX(-30rpx); }
  70% { transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1) translateX(0); }
}

@keyframes bubble-pop-right {
  0% { opacity: 0; transform: scale(0.6) translateX(30rpx); }
  70% { transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1) translateX(0); }
}

@keyframes float1 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(15rpx, 20rpx); }
}
@keyframes float2 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-10rpx, -15rpx); }
}
@keyframes float3 {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(8rpx, -10rpx); }
}
