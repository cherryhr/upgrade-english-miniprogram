/* pages/unit/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255,255,255,0.95);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 100rpx;
  z-index: 99;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #1B4FD8;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #1B4FD8;
  border-radius: 3rpx;
}

/* 音标列表 */
.phonetic-list {
  white-space: nowrap;
  padding: 20rpx 0;
  background: white;
}

.phonetic-scroll {
  display: inline-flex;
  padding: 0 20rpx;
}

.phonetic-chip {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin: 0 10rpx;
  background: #f0f0f0;
  border-radius: 40rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.phonetic-chip.active {
  background: #1B4FD8;
  color: white;
}

/* 音标详情 */
.phonetic-detail {
  padding: 30rpx;
}

.phonetic-header {
  text-align: center;
  padding: 40rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.phonetic-large {
  font-size: 80rpx;
  font-weight: bold;
  color: #1B4FD8;
  display: block;
  margin-bottom: 10rpx;
}

.phonetic-hint {
  font-size: 26rpx;
  color: #999;
}

/* 单词网格 */
.word-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.word-card {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  transition: all 0.2s;
}

.word-card:active {
  transform: scale(0.95);
  background: #f0f8ff;
}

.word-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.word-hint {
  font-size: 24rpx;
  color: #1B4FD8;
}

/* 播放全部按钮 */
.play-all-btn {
  text-align: center;
  padding: 30rpx;
  background: #1B4FD8;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 40rpx;
}

.play-all-btn.playing {
  background: #999;
}

/* 复习 Tab */
.review-tab {
  padding: 30rpx;
}

.review-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.review-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.review-desc {
  font-size: 28rpx;
  color: #999;
}

.review-content {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.review-section {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-section:last-child {
  border-bottom: none;
}

.review-phonetic {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #1B4FD8;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.review-words {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-word-tag {
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.review-actions {
  text-align: center;
}

.action-btn {
  display: inline-block;
  padding: 24rpx 60rpx;
  background: #FF6B6B;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
}

/* 游戏 Tab */
.games-tab {
  padding: 30rpx;
}

.games-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.games-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.game-card {
  background: white;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  transition: all 0.2s;
}

.game-card:active {
  transform: scale(0.95);
}

.game-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.game-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #999;
}
