/* pages/unit/index.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1628 0%, #0d1f3c 100%);
  padding: 0 24rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.back-btn {
  font-size: 30rpx;
  color: #F5C518;
  font-weight: 700;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: white;
}

.nav-spacer {
  width: 80rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.tab-item {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  background: #F5C518;
  color: #1B4FD8;
  border-color: #F5C518;
}

/* 内容区 */
.content {
  padding-bottom: 40rpx;
}

/* 词汇网格 */
.vocab-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.vocab-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx 10rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: transform 0.15s;
}

.vocab-card:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.vocab-emoji {
  display: block;
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.vocab-en {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #1B4FD8;
}

.vocab-zh {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-top: 2rpx;
}

/* ABC 字母卡片特殊样式 */
.abc-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.abc-card .vocab-en {
  font-size: 56rpx;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.abc-card .vocab-zh {
  color: rgba(255,255,255,0.8);
  font-size: 18rpx;
}

/* 问答列表 */
.qa-list {}

.qa-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.qa-q, .qa-a {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qa-q {
  background: #E3F2FD;
}

.qa-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.qa-text-wrap {
  flex: 1;
}

.qa-en {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1565C0;
}

.qa-zh {
  display: block;
  font-size: 22rpx;
  color: #555;
  margin-top: 2rpx;
}

.qa-speak {
  font-size: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* 歌曲卡片 */
.song-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.song-title {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 16rpx;
}

.song-progress-bar {
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.song-progress-fill {
  height: 100%;
  background: #F5C518;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.song-current {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

.song-lyric {
  font-size: 36rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 24rpx;
}

.song-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.song-btn {
  font-size: 40rpx;
  padding: 10rpx;
}

.song-play-btn {
  background: #F5C518;
  color: #1B4FD8;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 800;
}

/* 歌词列表 */
.lyrics-list {
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  overflow: hidden;
}

/* 歌曲视频区域 */
.song-videos-section {
  margin-bottom: 24rpx;
}

.song-videos-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #F5C518;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.song-video-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.song-video-item {
  background: rgba(255,255,255,0.08);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.2s;
  border: 2rpx solid rgba(255,255,255,0.06);
}

.song-video-item:active {
  transform: scale(0.97);
  background: rgba(255,255,255,0.12);
}

.sv-icon {
  font-size: 40rpx;
  color: #F5C518;
  flex-shrink: 0;
}

.sv-info {
  flex: 1;
}

.sv-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 4rpx;
}

.sv-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 视频播放器弹窗 */
.video-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.video-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.video-back {
  color: #F5C518;
  font-size: 32rpx;
  font-weight: 700;
  padding: 30rpx;
  text-align: center;
}

.video-player-wrap {
  flex: 1;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-bottom-info {
  padding: 24rpx 30rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.vi-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 6rpx;
}

.vi-unit {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.lyric-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
  transition: background 0.2s;
}

.lyric-item:last-child { border-bottom: none; }

.lyric-item.active {
  background: rgba(245, 197, 24, 0.15);
}

.lyric-num {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  min-width: 40rpx;
  text-align: center;
}

.lyric-texts { flex: 1; }

.lyric-en {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: white;
}

.lyric-zh {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 2rpx;
}

/* 游戏网格 */
.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.game-card {
  background: rgba(255,255,255,0.08);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: transform 0.2s;
}

.game-card:active { transform: scale(0.96); }

.game-emoji { display: block; font-size: 64rpx; margin-bottom: 12rpx; }

.game-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
}

.game-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 游戏区域 */
.game-area {
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.game-title {
  font-size: 30rpx;
  font-weight: 800;
  color: white;
}

.game-moves, .game-score {
  font-size: 24rpx;
  color: #F5C518;
  font-weight: 700;
}

.game-progress {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 700;
}

/* Memory Match */
.memory-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

/* 匹配提示 */
.memory-hint {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  animation: pulse 0.5s ease;
}

/* 成功提示样式 */
.memory-hint.hint-success {
  background: linear-gradient(135deg, #00cec9, #0984e3);
  box-shadow: 0 4rpx 20rpx rgba(0, 206, 201, 0.4);
}

/* 胜利提示样式 */
.memory-hint.hint-win {
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  box-shadow: 0 4rpx 20rpx rgba(253, 203, 110, 0.5);
  font-size: 36rpx;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

/* 下一题按钮 */
.memory-next-btn {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(39, 174, 96, 0.3);
  animation: pulse 0.5s ease;
}

/* 重新开始按钮 */
.memory-restart-btn {
  background: linear-gradient(135deg, #F5C518, #FF6B6B);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(245, 197, 24, 0.3);
}

/* 调试信息 */
.debug-info {
  background: rgba(255, 200, 0, 0.2);
  border: 2rpx dashed #F5C518;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  color: #F5C518;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.memory-card {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.memory-card.flipped {
  background: white;
}

.memory-card.matched {
  background: #27AE60;
}

.card-front, .card-back {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: opacity 0.3s ease;
}

.card-front {
  color: white;
  font-size: 48rpx;
  font-weight: 900;
}

.card-back {
  opacity: 0;
}

.memory-card.flipped .card-front,
.memory-card.matched .card-front {
  opacity: 0;
}

.memory-card.flipped .card-back,
.memory-card.matched .card-back {
  opacity: 1;
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.card-emoji {
  font-size: 56rpx;
  margin-bottom: 4rpx;
}

.card-en {
  font-size: 32rpx;
  font-weight: 800;
  color: #1B4FD8;
  text-align: center;
  word-break: break-word;
  line-height: 1.2;
  padding: 0 8rpx;
}

.card-emoji {
  display: block;
  font-size: 56rpx;
  margin-bottom: 4rpx;
}

.card-en {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1B4FD8;
  text-align: center;
  word-break: break-word;
  line-height: 1.2;
  padding: 0 8rpx;
}

/* Quiz */
.quiz-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.quiz-q {
  background: #E3F2FD;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quiz-icon { font-size: 56rpx; }

.quiz-en {
  font-size: 30rpx;
  font-weight: 800;
  color: #1565C0;
  text-align: center;
}

.quiz-zh {
  font-size: 24rpx;
  color: #555;
}

.quiz-options {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quiz-option {
  background: #f5f5f5;
  color: #333;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s;
}

.quiz-option:active { transform: scale(0.98); }

.quiz-option.correct {
  background: #27AE60;
  color: white;
}

.quiz-option.wrong {
  background: #e74c3c;
  color: white;
}

.quiz-option.disabled {
  opacity: 0.5;
}

/* Spelling */
.spelling-prompt {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.spelling-emoji { display: block; font-size: 80rpx; margin-bottom: 12rpx; }

.spelling-word {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.spelling-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

.spelling-input-wrap {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.spelling-input {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.spelling-check-btn {
  background: #1B4FD8;
  color: white;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.spelling-result {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 12rpx;
}

.spelling-result text { color: #27AE60; }

/* Bubble */
.bubble-prompt {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.bubble-task {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.bubble-word {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1B4FD8;
}

.bubble-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.bubble-item {
  background: linear-gradient(135deg, #74b9ff, #0984e3);
  color: white;
  padding: 40rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  transition: transform 0.15s;
}

.bubble-item:active { transform: scale(0.95); }

.bubble-item.correct { background: linear-gradient(135deg, #00b894, #27AE60); }
.bubble-item.wrong { background: linear-gradient(135deg, #d63031, #e74c3c); }

/* 下一题按钮 */
.bubble-next-btn {
  background: linear-gradient(135deg, #00b894, #27AE60);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(39, 174, 96, 0.3);
}

/* 游戏返回按钮 */
.game-back {
  text-align: center;
  color: #F5C518;
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx;
}
