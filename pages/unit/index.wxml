<!-- pages/unit/index.wxml -->
<view class="page" style="background: {{unit.color}}">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">{{unit.emoji}} {{unit.name}}</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{tab === 'phonetic' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="phonetic">
      <text>音标学习</text>
    </view>
    <view class="tab-item {{tab === 'review' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="review">
      <text>总复习</text>
    </view>
    <view class="tab-item {{tab === 'games' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="games">
      <text>游戏</text>
    </view>
  </view>

  <!-- 音标学习 Tab -->
  <view class="phonetic-tab" wx:if="{{tab === 'phonetic'}}">
    <!-- 音标规则列表 -->
    <scroll-view class="phonetic-list" scroll-x>
      <view class="phonetic-scroll">
        <view wx:for="{{phoneticList}}" wx:key="index"
              class="phonetic-chip {{currentPhoneticIndex === index ? 'active' : ''}}"
              bindtap="selectPhonetic" data-idx="{{index}}">
          <text class="phonetic-text">{{item.phonetic}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 当前音标详情 -->
    <view class="phonetic-detail" wx:if="{{phoneticList.length > 0}}">
      <view class="phonetic-header" bindtap="speakPhonetic" data-phonetic="{{phoneticList[currentPhoneticIndex].phonetic}}">
        <text class="phonetic-large">{{phoneticList[currentPhoneticIndex].phonetic}}</text>
        <text class="phonetic-hint">点击播放音标发音</text>
      </view>

      <!-- 单词列表 -->
      <view class="word-grid">
        <view wx:for="{{currentWords}}" wx:key="*this"
              class="word-card"
              bindtap="speakWord" data-word="{{item}}">
          <text class="word-text">{{item}}</text>
          <text class="word-hint">点击发音</text>
        </view>
      </view>

      <!-- 播放全部按钮 -->
      <view class="play-all-btn" bindtap="playAllWords" wx:if="{{!isPlaying}}">
        <text>🔊 播放全部单词</text>
      </view>
      <view class="play-all-btn playing" wx:else>
        <text>🔊 播放中...</text>
      </view>
    </view>
  </view>

  <!-- 总复习 Tab -->
  <view class="review-tab" wx:if="{{tab === 'review'}}">
    <view class="review-header">
      <text class="review-title">📝 {{unit.name}} 总复习</text>
      <text class="review-desc">复习本单元所有音标和单词</text>
    </view>

    <view class="review-content">
      <view wx:for="{{phoneticList}}" wx:key="index" class="review-section">
        <view class="review-phonetic" bindtap="speakPhonetic" data-phonetic="{{item.phonetic}}">
          <text class="review-phonetic-text">{{item.phonetic}}</text>
        </view>
        <view class="review-words">
          <text wx:for="{{item.words}}" wx:key="*this" 
                class="review-word-tag"
                bindtap="speakWord" data-word="{{item}}">
            {{item}}
          </text>
        </view>
      </view>
    </view>

    <view class="review-actions">
      <view class="action-btn" bindtap="goReview">
        <text>开始复习测试</text>
      </view>
    </view>
  </view>

  <!-- 游戏 Tab -->
  <view class="games-tab" wx:if="{{tab === 'games'}}">
    <view class="games-header">
      <text class="games-title">🎮 选择游戏</text>
    </view>

    <view class="games-grid">
      <view class="game-card" bindtap="goGame" data-type="memory">
        <text class="game-icon">🃏</text>
        <text class="game-name">记忆配对</text>
        <text class="game-desc">找出匹配的单词</text>
      </view>

      <view class="game-card" bindtap="goGame" data-type="quiz">
        <text class="game-icon">❓</text>
        <text class="game-name">选择题</text>
        <text class="game-desc">选出正确单词</text>
      </view>

      <view class="game-card" bindtap="goGame" data-type="spelling">
        <text class="game-icon">✏️</text>
        <text class="game-name">拼写游戏</text>
        <text class="game-desc">听音拼写单词</text>
      </view>

      <view class="game-card" bindtap="goGame" data-type="bubble">
        <text class="game-icon">🫧</text>
        <text class="game-name">泡泡闯关</text>
        <text class="game-desc">戳破正确泡泡</text>
      </view>
    </view>
  </view>
</view>
