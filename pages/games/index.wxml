<!--pages/games/index.wxml-->
<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">{{gameTitle}}</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- Memory Match 游戏 -->
  <view class="game-container" wx:if="{{gameType === 'memory' && isGameStarted}}">
    <view class="game-info">
      <text>步数: {{moves}}</text>
      <text>匹配: {{matchedPairs}} / {{cards.length / 2}}</text>
    </view>

    <view class="memory-grid">
      <view wx:for="{{cards}}" wx:key="id" 
            class="memory-card {{item.flipped || item.matched ? 'flipped' : ''}}" 
            bindtap="onCardTap" data-idx="{{index}}">
        <view class="card-inner {{item.flipped || item.matched ? 'flipped' : ''}}">
          <view class="card-front">?</view>
          <view class="card-back">{{item.text}}</view>
        </view>
      </view>
    </view>

    <view class="game-actions" wx:if="{{isGameFinished}}">
      <button class="action-btn" bindtap="restartMemory">再来一次</button>
    </view>
  </view>

  <!-- Quiz Time 游戏 -->
  <view class="game-container" wx:if="{{gameType === 'quiz' && isGameStarted}}">
    <view class="game-info">
      <text>题目: {{currentQuizIndex + 1}} / {{quizTotal}}</text>
      <text>得分: {{quizScore}}</text>
    </view>

    <view wx:if="{{!showQuizResult && quizQuestions.length > 0}}">
      <view class="quiz-question">
        <text class="question-text">{{quizQuestions[currentQuizIndex].question}}</text>
        <button class="play-btn" bindtap="showQuizQuestion">🔊 播放</button>
      </view>

      <view class="quiz-options">
        <view wx:for="{{quizQuestions[currentQuizIndex].options}}" wx:key="*this" 
              class="quiz-option" 
              bindtap="selectQuizAnswer" data-answer="{{item}}">
          <text>{{item}}</text>
        </view>
      </view>

      <button class="next-btn" wx:if="{{isQuizAnswered}}" bindtap="nextQuizQuestion">
        {{currentQuizIndex + 1 >= quizTotal ? '查看结果' : '下一题'}}
      </button>
    </view>

    <view class="result-card" wx:if="{{showQuizResult}}">
      <text class="result-emoji">🎉</text>
      <text>测验完成！</text>
      <text>得分: {{quizScore}} / {{quizTotal}}</text>
      <button class="action-btn" bindtap="restartQuiz">再来一次</button>
    </view>
  </view>

  <!-- Spelling Bee 游戏 -->
  <view class="game-container" wx:if="{{gameType === 'spelling' && isGameStarted}}">
    <view class="game-info">
      <text>单词: {{currentSpellingIndex + 1}} / {{spellingWords.length}}</text>
      <text>得分: {{spellingScore}}</text>
    </view>

    <view wx:if="{{!isGameFinished}}">
      <view class="spelling-area">
        <button class="play-btn-large" bindtap="playSpellingWord">🔊 听单词</button>
        
        <view class="input-area">
          <input value="{{userInput}}" bindinput="onSpellingInput" placeholder="输入你听到的单词" />
          <button bindtap="submitSpelling">确认</button>
        </view>

        <view wx:if="{{showSpellingResult}}" class="spelling-result">
          <text>{{isSpellingCorrect ? '✅ 正确！' : '❌ 错误'}}</text>
          <text>正确答案: {{spellingWords[currentSpellingIndex]}}</text>
          <button bindtap="nextSpellingWord">
            {{currentSpellingIndex + 1 >= spellingWords.length ? '完成' : '下一个'}}
          </button>
        </view>
      </view>
    </view>

    <view class="result-card" wx:if="{{isGameFinished}}">
      <text class="result-emoji">🎉</text>
      <text>拼写完成！</text>
      <text>得分: {{spellingScore}} / {{spellingWords.length}}</text>
      <button class="action-btn" bindtap="restartSpelling">再来一次</button>
    </view>
  </view>

  <!-- Bubble Pop 游戏 -->
  <view class="game-container" wx:if="{{gameType === 'bubble' && isGameStarted}}">
    <view class="game-info">
      <text>得分: {{bubbleScore}}</text>
      <text>时间: {{bubbleTime}}s</text>
    </view>

    <view class="result-card" wx:if="{{isGameFinished}}">
      <text class="result-emoji">🎉</text>
      <text>游戏结束！</text>
      <text>最终得分: {{bubbleScore}}</text>
      <button class="action-btn" bindtap="restartBubble">再来一次</button>
    </view>
  </view>
</view>
