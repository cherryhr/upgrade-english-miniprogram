<!-- pages/games/index.wxml -->
<view class="page">
  <view class="header">
    <view class="header-emoji">🎮</view>
    <view class="header-title">Super Games!</view>
    <view class="header-sub">练习游戏 · 游戏中心</view>
    <view class="header-stats">
      <text class="stat-item">⭐ {{stars}} 星星</text>
      <text class="stat-item" wx:if="{{streak > 0}}">🔥 {{streak}}天连续</text>
    </view>
  </view>

  <!-- 快速游戏 -->
  <view class="section-title">⚡ 选择游戏类型</view>
  <view class="quick-games">
    <view class="quick-game" bindtap="chooseUnit" data-type="memory">
      <text class="qg-emoji">🃏</text>
      <text class="qg-name">Memory Match</text>
      <text class="qg-desc">翻牌记忆配对</text>
    </view>
    <view class="quick-game" bindtap="chooseUnit" data-type="quiz">
      <text class="qg-emoji">🧠</text>
      <text class="qg-name">Quiz Time!</text>
      <text class="qg-desc">知识问答挑战</text>
    </view>
    <view class="quick-game" bindtap="chooseUnit" data-type="spelling">
      <text class="qg-emoji">🐝</text>
      <text class="qg-name">Spelling Bee</text>
      <text class="qg-desc">拼写挑战</text>
    </view>
    <view class="quick-game" bindtap="chooseUnit" data-type="bubble">
      <text class="qg-emoji">🫧</text>
      <text class="qg-name">Bubble Pop</text>
      <text class="qg-desc">泡泡消消乐</text>
    </view>
  </view>

  <!-- 单元选择 -->
  <view wx:if="{{showUnitPicker}}" class="unit-picker">
    <view class="picker-header">
      <text class="picker-back" bindtap="hideUnitPicker">‹ 返回</text>
      <text class="picker-title">{{gameName}}</text>
      <text class="picker-spacer"></text>
    </view>
    <view class="unit-grid">
      <view 
        class="unit-cell" 
        wx:for="{{units}}" 
        wx:key="id"
        bindtap="startGame" 
        data-id="{{item.id}}"
        style="border-left: 4rpx solid {{item.color}}"
      >
        <text class="unit-cell-emoji">{{item.emoji}}</text>
        <text class="unit-cell-id">U{{item.id.slice(1)}}</text>
        <text class="unit-cell-name">{{item.zh}}</text>
      </view>
    </view>
  </view>
</view>
