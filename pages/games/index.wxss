/* pages/games/index.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1628 0%, #0d1f3c 100%);
  padding: 0 24rpx;
}

.header {
  text-align: center;
  padding: 50rpx 0 30rpx;
}

.header-emoji { font-size: 80rpx; margin-bottom: 12rpx; }

.header-title {
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #F5C518, #FF8C42);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 16rpx;
}

.header-stats {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.stat-item {
  font-size: 26rpx;
  font-weight: 700;
  color: #F5C518;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  margin-bottom: 20rpx;
  text-align: center;
}

.quick-games {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.quick-game {
  background: rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  transition: transform 0.2s;
}

.quick-game:active { transform: scale(0.96); }

.qg-emoji { display: block; font-size: 72rpx; margin-bottom: 12rpx; }

.qg-name {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
}

.qg-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 单元选择器 */
.unit-picker {
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.picker-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.picker-back {
  color: #F5C518;
  font-size: 28rpx;
  font-weight: 700;
  padding: 10rpx 0;
}

.picker-title {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: white;
}

.picker-spacer { width: 80rpx; }

.unit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.unit-cell {
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  transition: transform 0.2s;
}

.unit-cell:active { transform: scale(0.95); }

.unit-cell-emoji { display: block; font-size: 48rpx; margin-bottom: 6rpx; }

.unit-cell-id {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  margin-bottom: 4rpx;
}

.unit-cell-name {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: white;
}
