/* pages/games/index.wxss */

.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.nav-back {
  font-size: 48rpx;
  color: #667eea;
  font-weight: bold;
  padding: 10rpx 20rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 80rpx;
}

/* 游戏容器 */
.game-container {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 40rpx;
  min-height: 70vh;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 游戏信息栏 */
.game-info {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

/* Memory Match 游戏样式 */
.memory-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
  padding: 20rpx;
}

.memory-card {
  width: calc(25% - 15rpx);
  aspect-ratio: 1;
  perspective: 1000rpx;
  cursor: pointer;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s;
  transform-style: preserve-3d;
}

.card-inner.flipped {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: bold;
  backface-visibility: hidden;
}

.card-front {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.card-back {
  background: white;
  color: #333;
  transform: rotateY(180deg);
  border: 3rpx solid #667eea;
  padding: 10rpx;
  font-size: 24rpx;
  text-align: center;
  word-break: break-all;
}

/* Quiz Time 游戏样式 */
.quiz-question {
  text-align: center;
  margin-bottom: 50rpx;
}

.question-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  display: block;
  margin-bottom: 30rpx;
}

.play-btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.quiz-option {
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  border: 3rpx solid transparent;
}

.quiz-option:active {
  background: #e7f3ff;
  border-color: #667eea;
}

.next-btn {
  margin-top: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 50rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

/* Spelling Bee 游戏样式 */
.spelling-area {
  padding: 40rpx;
  text-align: center;
}

.play-btn-large {
  display: inline-block;
  padding: 40rpx 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 50rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.input-area {
  margin-top: 40rpx;
}

.input-area input {
  width: 100%;
  padding: 30rpx;
  font-size: 36rpx;
  border: 3rpx solid #667eea;
  border-radius: 15rpx;
  text-align: center;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}

.input-area button {
  margin-top: 30rpx;
  padding: 30rpx;
  background: #667eea;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
}

.spelling-result {
  margin-top: 40rpx;
}

.spelling-result text {
  display: block;
  margin: 20rpx 0;
  font-size: 32rpx;
}

/* 结果页面 */
.result-card {
  text-align: center;
  padding: 60rpx;
}

.result-emoji {
  font-size: 100rpx;
  display: block;
  margin-bottom: 30rpx;
}

.result-card text:nth-child(2) {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.result-card text:nth-child(3) {
  font-size: 36rpx;
  color: #667eea;
  display: block;
  margin-bottom: 50rpx;
  font-weight: 500;
}

/* 游戏操作按钮 */
.game-actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.game-actions button,
.action-btn {
  padding: 30rpx 60rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  min-width: 300rpx;
}
