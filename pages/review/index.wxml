<!-- pages/review/index.wxml - 综合复习游戏 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="goBack">‹ 返回</view>
    <view class="nav-title">📚 综合复习</view>
    <view class="nav-spacer"></view>
  </view>

  <!-- 开始页面 -->
  <view wx:if="{{!gameStarted && !gameOver}}" class="start-section">
    <view class="start-card">
      <view class="start-icon">🎯</view>
      <view class="start-title">综合复习游戏</view>
      <view class="start-desc">
        测试你学过的所有知识！<br/>
        共 {{totalQuestions}} 道题<br/>
        包括词汇和句型
      </view>

      <view class="start-stats">
        <view class="stat-item">
          <text class="stat-num">{{totalQuestions}}</text>
          <text class="stat-label">总题数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">12</text>
          <text class="stat-label">涵盖单元</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">100%</text>
          <text class="stat-label">随机出题</text>
        </view>
      </view>

      <view class="start-rules">
        <view class="rule-title">评分标准</view>
        <view class="rule-item great">🌟 Great - 80分以上</view>
        <view class="rule-item good">👍 Well done - 60-79分</view>
        <view class="rule-item need">💪 To be improved - 60分以下</view>
      </view>

      <view class="start-btn" bindtap="startGame">
        🚀 开始挑战
      </view>
    </view>
  </view>

  <!-- 游戏进行中 -->
  <view wx:if="{{gameStarted && !gameOver}}" class="game-section">
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="progress-text">第 {{currentIndex + 1}} / {{questions.length}} 题</view>

    <!-- 得分 -->
    <view class="score-bar">
      <view class="score-item correct">
        <text class="score-icon">✓</text>
        <text class="score-num">{{correctCount}}</text>
      </view>
      <view class="score-item wrong">
        <text class="score-icon">✗</text>
        <text class="score-num">{{wrongCount}}</text>
      </view>
      <view class="score-item total">
        <text class="score-icon">⭐</text>
        <text class="score-num">{{score}}</text>
      </view>
    </view>

    <!-- 题目卡片 -->
    <view class="question-card" wx:if="{{currentQuestion}}">
      <!-- 单元标识 -->
      <view class="question-unit">
        <text>{{currentQuestion.unitEmoji}} {{currentQuestion.unitName}}</text>
      </view>

      <!-- 题目类型 -->
      <view class="question-type">
        {{currentQuestion.type === 'vocab' ? '📝 词汇' : '💬 句型'}}
      </view>

      <!-- 题目内容 -->
      <view class="question-content">
        <view class="question-emoji">{{currentQuestion.emoji}}</view>
        <view class="question-text">
          <text class="q-main">{{currentQuestion.question}}</text>
          <text class="q-sub" wx:if="{{currentQuestion.questionZh}}">{{currentQuestion.questionZh}}</text>
        </view>
      </view>

      <!-- 播放按钮 -->
      <view class="replay-btn" bindtap="replayQuestion">
        🔊 再听一遍
      </view>
    </view>

    <!-- 选项 -->
    <view class="options-grid">
      <view
        wx:for="{{options}}"
        wx:key="index"
        class="option-btn {{selectedAnswer === item ? (isCorrect ? 'correct' : 'wrong') : ''}} {{answered && item === currentQuestion.answer ? 'show-correct' : ''}}"
        bindtap="selectAnswer"
        data-answer="{{item}}"
      >
        <text class="option-text">{{item}}</text>
      </view>
    </view>

    <!-- 答题反馈 -->
    <view wx:if="{{answered}}" class="feedback {{isCorrect ? 'correct' : 'wrong'}}">
      <text wx:if="{{isCorrect}}">✅ 正确！+10分</text>
      <text wx:if="{{!isCorrect}}">❌ 回答：{{selectedAnswer}}</text>
    </view>
  </view>

  <!-- 游戏结束 -->
  <view wx:if="{{gameOver}}" class="result-section">
    <view class="result-card">
      <!-- 评价 -->
      <view class="result-emoji">{{finalEmoji}}</view>
      <view class="result-comment">{{finalComment}}</view>
      <view class="result-grade">{{finalGrade}}</view>

      <!-- 成绩详情 -->
      <view class="result-stats">
        <view class="result-stat">
          <text class="rs-num correct">{{correctCount}}</text>
          <text class="rs-label">正确</text>
        </view>
        <view class="result-stat">
          <text class="rs-num wrong">{{wrongCount}}</text>
          <text class="rs-label">错误</text>
        </view>
        <view class="result-stat">
          <text class="rs-num total">{{totalQuestions}}</text>
          <text class="rs-label">总计</text>
        </view>
      </view>

      <!-- 正确率 -->
      <view class="result-percent">
        <text class="percent-num">{{correctCount}} / {{totalQuestions}}</text>
        <text class="percent-label">正确 / 总题</text>
      </view>

      <!-- 分数 -->
      <view class="result-score">
        <text class="score-num">{{score}}</text>
        <text class="score-label">得分</text>
      </view>

      <!-- 按钮 -->
      <view class="result-btns">
        <view class="result-btn primary" bindtap="restartGame">
          🔄 再来一局
        </view>
        <view class="result-btn secondary" bindtap="goBack">
          🏠 返回
        </view>
      </view>
    </view>
  </view>
</view>
