<!-- pages/review/index.wxml -->
<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">📝 总复习</view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 进度 -->
  <view class="progress-bar" wx:if="{{!isFinished}}">
    <view class="progress-fill" style="width: {{(currentIndex / totalQuestions) * 100}}%"></view>
    <text class="progress-text">{{currentIndex + 1}} / {{totalQuestions}}</text>
  </view>

  <!-- 题目卡片 -->
  <view class="question-card" wx:if="{{!isFinished && currentItem}}">
    <view class="question-type" wx:if="{{currentItem.type === 'phonetic'}}">
      <text class="question-label">请听音标发音</text>
      <view class="phonetic-display" bindtap="playQuestion">
        <text class="phonetic-text">{{currentItem.question}}</text>
        <text class="play-hint">🔊 点击播放</text>
      </view>
    </view>

    <view class="question-type" wx:if="{{currentItem.type === 'word'}}">
      <text class="question-label">请听单词发音</text>
      <view class="word-display" bindtap="playQuestion">
        <text class="word-text">{{currentItem.question}}</text>
        <text class="play-hint">🔊 点击播放</text>
      </view>
      <text class="phonetic-hint">音标: {{currentItem.phonetic}}</text>
    </view>

    <!-- 选择答案 -->
    <view class="choices" wx:if="{{showChoices}}">
      <view wx:for="{{choices}}" wx:key="*this"
            class="choice-btn {{isAnswered ? (item === currentItem.answer ? 'correct' : (item === selectedAnswer ? 'wrong' : '')) : ''}}"
            bindtap="selectAnswer" data-answer="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>

    <view class="action-row" wx:if="{{!showChoices}}">
      <view class="action-btn" bindtap="showChoices">
        <text>显示选项</text>
      </view>
    </view>

    <view class="action-row" wx:if="{{isAnswered}}">
      <view class="action-btn next" bindtap="nextQuestion">
        <text>{{currentIndex + 1 >= totalQuestions ? '查看结果' : '下一题'}}</text>
      </view>
    </view>
  </view>

  <!-- 完成页面 -->
  <view class="finished-card" wx:if="{{isFinished}}">
    <text class="finished-emoji">🎉</text>
    <text class="finished-title">复习完成！</text>
    <text class="finished-score">得分：{{score}} / {{totalQuestions}}</text>
    <view class="finished-actions">
      <view class="action-btn" bindtap="restartReview">
        <text>再次复习</text>
      </view>
      <view class="action-btn secondary" bindtap="goBack">
        <text>返回</text>
      </view>
    </view>
  </view>
</view>
