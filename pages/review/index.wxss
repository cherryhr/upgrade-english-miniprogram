/* pages/review/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 200rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-placeholder {
  width: 60rpx;
}

/* 进度条 */
.progress-bar {
  position: relative;
  height: 12rpx;
  background: #e0e0e0;
  margin: 20rpx 30rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #1B4FD8;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  position: absolute;
  right: -120rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #999;
}

/* 题目卡片 */
.question-card {
  margin: 30rpx;
  padding: 50rpx 40rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.question-label {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 音标显示 */
.phonetic-display,
.word-display {
  text-align: center;
  padding: 40rpx;
  background: #f8fbff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.phonetic-text {
  font-size: 100rpx;
  font-weight: bold;
  color: #1B4FD8;
  display: block;
  margin-bottom: 16rpx;
}

.word-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.play-hint {
  font-size: 26rpx;
  color: #1B4FD8;
}

.phonetic-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 选项 */
.choices {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
}

.choice-btn {
  padding: 30rpx;
  background: #f0f4f8;
  border-radius: 16rpx;
  text-align: center;
  font-size: 34rpx;
  color: #333;
  font-weight: 500;
  transition: all 0.2s;
}

.choice-btn:active {
  transform: scale(0.98);
}

.choice-btn.correct {
  background: #d4edda;
  color: #155724;
  border: 2rpx solid #c3e6cb;
}

.choice-btn.wrong {
  background: #f8d7da;
  color: #721c24;
  border: 2rpx solid #f5c6cb;
}

/* 按钮行 */
.action-row {
  margin-top: 40rpx;
  text-align: center;
}

.action-btn {
  display: inline-block;
  padding: 24rpx 80rpx;
  background: #1B4FD8;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.next {
  background: #27AE60;
}

/* 完成卡片 */
.finished-card {
  text-align: center;
  padding: 80rpx 40rpx;
  margin: 60rpx 30rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.finished-emoji {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.finished-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.finished-score {
  font-size: 36rpx;
  color: #1B4FD8;
  display: block;
  margin-bottom: 50rpx;
}

.finished-actions {
  display: flex;
  justify-content: center;
  gap: 30rpx;
}

.finished-actions .action-btn {
  padding: 24rpx 50rpx;
}

.finished-actions .action-btn.secondary {
  background: #6c757d;
}
