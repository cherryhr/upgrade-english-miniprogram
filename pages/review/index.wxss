/* pages/review/index.wxss - 综合复习游戏样式 */

.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding-bottom: 40rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.back-btn {
  color: #4fc3f7;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(79, 195, 247, 0.1);
}

.nav-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.nav-spacer {
  width: 100rpx;
}

/* ===== 开始页面 ===== */
.start-section {
  padding: 40rpx 30rpx;
}

.start-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.start-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.start-title {
  color: #fff;
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.start-desc {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

/* 统计 */
.start-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 30rpx 0;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  color: #4fc3f7;
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1px;
  background: rgba(255, 255, 255, 0.2);
}

/* 规则 */
.start-rules {
  margin-bottom: 40rpx;
}

.rule-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.rule-item {
  padding: 16rpx 24rpx;
  border-radius: 15rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.rule-item.great {
  background: linear-gradient(90deg, rgba(76, 175, 80, 0.2), rgba(76, 175, 80, 0.1));
  color: #81c784;
  border-left: 4rpx solid #4caf50;
}

.rule-item.good {
  background: linear-gradient(90deg, rgba(255, 193, 7, 0.2), rgba(255, 193, 7, 0.1));
  color: #ffd54f;
  border-left: 4rpx solid #ffc107;
}

.rule-item.need {
  background: linear-gradient(90deg, rgba(255, 152, 0, 0.2), rgba(255, 152, 0, 0.1));
  color: #ffb74d;
  border-left: 4rpx solid #ff9800;
}

/* 开始按钮 */
.start-btn {
  background: linear-gradient(135deg, #4fc3f7, #29b6f6);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 28rpx 60rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(79, 195, 247, 0.4);
  transition: all 0.3s ease;
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 5rpx 20rpx rgba(79, 195, 247, 0.3);
}

/* ===== 游戏进行中 ===== */
.game-section {
  padding: 30rpx;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4caf50, #8bc34a);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-text {
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

/* 得分栏 */
.score-bar {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.1);
}

.score-icon {
  font-size: 28rpx;
}

.score-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.score-item.correct {
  background: rgba(76, 175, 80, 0.2);
}

.score-item.correct .score-num {
  color: #81c784;
}

.score-item.wrong {
  background: rgba(244, 67, 54, 0.2);
}

.score-item.wrong .score-num {
  color: #e57373;
}

.score-item.total {
  background: rgba(79, 195, 247, 0.2);
}

.score-item.total .score-num {
  color: #4fc3f7;
}

/* 题目卡片 */
.question-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.question-unit {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.question-type {
  text-align: center;
  color: #4fc3f7;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.question-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.question-emoji {
  font-size: 80rpx;
  margin-bottom: 10rpx;
}

.question-text {
  text-align: center;
}

.q-main {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.q-sub {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
}

.replay-btn {
  margin-top: 30rpx;
  text-align: center;
  color: #4fc3f7;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  background: rgba(79, 195, 247, 0.15);
  border-radius: 30rpx;
  border: 1px solid rgba(79, 195, 247, 0.3);
}

/* 选项 */
.options-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.option-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.option-btn:active {
  transform: scale(0.95);
}

.option-text {
  color: #fff;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-word;
}

.option-btn.correct {
  background: rgba(76, 175, 80, 0.3);
  border-color: #4caf50;
}

.option-btn.wrong {
  background: rgba(244, 67, 54, 0.3);
  border-color: #f44336;
}

.option-btn.show-correct {
  background: rgba(76, 175, 80, 0.3);
  border-color: #4caf50;
}

/* 反馈 */
.feedback {
  text-align: center;
  margin-top: 30rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.feedback.correct {
  background: rgba(76, 175, 80, 0.2);
  color: #81c784;
}

.feedback.wrong {
  background: rgba(244, 67, 54, 0.2);
  color: #e57373;
}

/* ===== 游戏结束 ===== */
.result-section {
  padding: 60rpx 30rpx;
}

.result-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.result-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.result-comment {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.result-grade {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 50rpx;
}

/* 成绩统计 */
.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 20rpx;
}

.result-stat {
  text-align: center;
}

.rs-num {
  display: block;
  font-size: 50rpx;
  font-weight: bold;
}

.rs-num.correct {
  color: #81c784;
}

.rs-num.wrong {
  color: #e57373;
}

.rs-num.total {
  color: #4fc3f7;
}

.rs-label {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 正确率 */
.result-percent {
  margin-bottom: 20rpx;
}

.percent-num {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.percent-label {
  display: block;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}

/* 分数 */
.result-score {
  margin-bottom: 50rpx;
}

.result-score .score-num {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #ffd54f;
}

.result-score .score-label {
  display: block;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}

/* 按钮 */
.result-btns {
  display: flex;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.result-btn.primary {
  background: linear-gradient(135deg, #4fc3f7, #29b6f6);
  color: #fff;
}

.result-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.result-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}
