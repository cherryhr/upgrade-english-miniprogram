/* UpGrade English 全局样式 */

page {
  background: linear-gradient(180deg, #0a1628 0%, #1a2a4a 100%);
  min-height: 100vh;
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: white;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 标题 */
.title-xl {
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #F5C518, #FF8C42);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
  margin-bottom: 8rpx;
}

.title-lg {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5C518;
  text-align: center;
  margin-bottom: 30rpx;
}

.title-md {
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 20rpx;
}

/* 单元卡片 */
.unit-card {
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.12);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.unit-card:active {
  transform: scale(0.97);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}

.unit-emoji {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.unit-name {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 4rpx;
}

.unit-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 12rpx;
}

/* 进度条 */
.progress-bar {
  height: 10rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

/* 标签页 */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.tab-item {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.7);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  background: #F5C518;
  color: #1B4FD8;
  border-color: #F5C518;
}

/* 词汇卡片 */
.vocab-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 10rpx;
}

.vocab-card {
  background: white;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: transform 0.15s;
}

.vocab-card:active {
  transform: scale(0.95);
}

.vocab-emoji {
  font-size: 64rpx;
  margin-bottom: 6rpx;
}

.vocab-en {
  font-size: 22rpx;
  font-weight: 800;
  color: #1B4FD8;
}

.vocab-zh {
  font-size: 20rpx;
  color: #666;
  margin-top: 2rpx;
}

/* 游戏卡片 */
.game-card {
  background: rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  transition: transform 0.2s;
}

.game-card:active {
  transform: scale(0.96);
}

.game-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.game-name {
  font-size: 32rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 打卡按钮 */
.checkin-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5C518, #FF8C42);
  border: none;
  font-size: 36rpx;
  font-weight: 900;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(245,197,24,0.4);
  margin: 40rpx auto;
  transition: transform 0.2s;
}

.checkin-btn:active {
  transform: scale(0.9);
}

/* 星星徽章 */
.star-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: #F5C518;
  color: #1B4FD8;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 800;
}

/* 模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx;
  max-width: 600rpx;
  width: 90%;
  text-align: center;
}

/* 按钮 */
.btn-primary {
  background: #1B4FD8;
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  font-family: inherit;
}

.btn-gold {
  background: linear-gradient(135deg, #F5C518, #FF8C42);
  color: #1B4FD8;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 800;
  font-family: inherit;
}

/* 问答卡片 */
.qa-card {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.qa-q {
  background: #E3F2FD;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qa-icon { font-size: 48rpx; }

.qa-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1565C0;
  flex: 1;
}

.qa-a {
  background: white;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 无障碍 */
.text-center { text-align: center; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.px-20 { padding-left: 20rpx; padding-right: 20rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }
